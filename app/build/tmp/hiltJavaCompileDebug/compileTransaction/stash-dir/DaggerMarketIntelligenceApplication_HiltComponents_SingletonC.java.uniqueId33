          case 11: // com.example.marketintelligence.domain.engine.BuildupEngine 
          return (T) new BuildupEngine();

          case 12: // com.example.marketintelligence.data.repository.PortfolioRepositoryImpl 
          return (T) new PortfolioRepositoryImpl();

